# Deployment/service compatibility variables. The service directory and systemd unit keep
# the historical GPTLOCK_LICENSE_* names, but end-user authentication is account-based.
GPTLOCK_LICENSE_HOST=127.0.0.1
GPTLOCK_LICENSE_PORT=3188
GPTLOCK_LICENSE_DB=./data/gptlock-license.sqlite3
GPTLOCK_LICENSE_PUBLIC_ORIGIN=https://gptlock.mv3.cn
GPTLOCK_LICENSE_ADMIN_PASSWORD=replace-with-a-long-random-password
GPTLOCK_LICENSE_SECRET=replace-with-at-least-32-random-bytes
GPTLOCK_LICENSE_WINDOW_TTL_SECONDS=150
GPTLOCK_LICENSE_ADMIN_SESSION_HOURS=12

# Phase B capability leases. Generate a dedicated Ed25519 key pair outside Git.
# The PKCS#8 private key is a deployment secret and MUST exist only on the account server.
# Use literal \n escapes when an environment manager requires a single-line value.
# Do not reuse GPTLOCK_LICENSE_SECRET and never commit a real signing key.
# GPTLOCK_CAPABILITY_LEASE_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Lease lifetime is intentionally short; accepted range is 60..900 seconds.
GPTLOCK_CAPABILITY_LEASE_TTL_SECONDS=300

# Official extension IDs allowed to call browser-facing account endpoints.
# This is a browser/CORS hardening layer, not a cryptographic client identity proof.
GPTLOCK_LICENSE_ALLOWED_EXTENSION_IDS=bhchcpeodphgjfjoookncemnamdbfcof

# Administrator login brute-force protection.
GPTLOCK_LICENSE_ADMIN_LOGIN_MAX_ATTEMPTS=8
GPTLOCK_LICENSE_ADMIN_LOGIN_WINDOW_MS=900000

# Account/password authentication protection.
GPTLOCK_ACCOUNT_LOGIN_MAX_ATTEMPTS=10
GPTLOCK_ACCOUNT_LOGIN_IP_MAX_ATTEMPTS=30
GPTLOCK_ACCOUNT_LOGIN_WINDOW_MS=900000
GPTLOCK_ACCOUNT_EMAIL_MAX_ATTEMPTS=5
GPTLOCK_ACCOUNT_EMAIL_IP_MAX_ATTEMPTS=15
GPTLOCK_ACCOUNT_EMAIL_WINDOW_MS=600000
GPTLOCK_ACCOUNT_EMAIL_CODE_TTL_MINUTES=15
GPTLOCK_ACCOUNT_EMAIL_CODE_MAX_ATTEMPTS=6

# TEST ONLY. Never enable this in production: verification/reset codes are kept in an
# in-memory test outbox instead of being delivered by SMTP.
# GPTLOCK_ACCOUNT_EMAIL_TEST_MODE=1

# SMTP host/credentials, free-user rights, membership pricing and WeChat/Alipay payment
# entry points are configured from /admin/ and stored in SQLite. SMTP passwords are
# encrypted at rest with an AES-256-GCM key derived from GPTLOCK_LICENSE_SECRET.

# Private GitHub release access. The server uses this read-only token to discover formal
# Releases, download assets and mirror them locally. The token is never returned to clients.
# GPTLOCK_GITHUB_TOKEN=github_pat_read_only_token

# Local release mirror.
# GPTLOCK_RELEASE_MIRROR_DIR=/var/lib/gptlock-license/releases
GPTLOCK_RELEASE_SYNC_INTERVAL_MS=60000
GPTLOCK_RELEASE_FETCH_RETRIES=2
GPTLOCK_RELEASE_ASSET_TIMEOUT_MS=60000
GPTLOCK_RELEASE_TRANSPORT=auto
# GPTLOCK_RELEASE_PROXY=socks5h://127.0.0.1:10808
# GPTLOCK_RELEASE_CURL_BIN=/usr/bin/curl
# GPTLOCK_RELEASE_MAX_RESPONSE_BYTES=268435456

# Server-side source-code updater.
GPTLOCK_UPDATE_REF=main
GPTLOCK_UPDATE_TRANSPORT=auto
GPTLOCK_UPDATE_FETCH_RETRIES=2
GPTLOCK_UPDATE_FETCH_TIMEOUT_SECONDS=60
GPTLOCK_UPDATE_SSH_CONNECT_TIMEOUT_SECONDS=12
GPTLOCK_UPDATE_SSH_KEEPALIVE_SECONDS=10
GPTLOCK_UPDATE_HTTPS_LOW_SPEED_TIME_SECONDS=30
GPTLOCK_UPDATE_HTTPS_LOW_SPEED_LIMIT_BYTES=1024

# GPTLOCK_UPDATE_REPO_DIR=/www/wwwroot/GPTWork
# GPTLOCK_UPDATE_DATA_DIR=/var/lib/gptlock-license
# GPTLOCK_UPDATE_NODE_BIN=/usr/local/bin/node22
# GPTLOCK_UPDATE_SERVICE=gptlock-license.service
# GPTLOCK_UPDATE_SSH_KNOWN_HOSTS=/path/to/github-known-hosts
