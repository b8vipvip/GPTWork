{
  "manifest_version": 3,
  "name": "GPTWork",
  "version": "0.5.54",
  "description": "ChatGPT 正式聊天请求模型锁定与响应证据确认 / Formal chat request locking and evidence-based response verification.",
  "minimum_chrome_version": "110",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gptlock.mv3.cn/*"
  ],
  "background": {
    "service_worker": "background-entry.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content-local-error-capture.js",
        "floating-ui-master-state.js",
        "page-model-evidence.js",
        "astra-model-evidence.js",
        "context-budget.js",
        "private-context-budget-authority.js",
        "content.js",
        "model-status-history.js",
        "model-catalog.js",
        "work-mode-controller.js",
        "model-status-continuity.js",
        "model-auto-lock.js",
        "multi-window-lock-sync.js",
        "chat-length-hard-limit-semantic.js",
        "chat-length-remaining-indicator.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "settings-v0521.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "GPTWork",
    "default_popup": "popup-v0513.html"
  }
}
